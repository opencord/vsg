#!/bin/bash
#**************************************************************/
#** File:         wide-dhcp6.vars                             */
#** Contents:     Contains IPv6 params used for generating    */
#**               wide-dhcp6 server/client configuration file.*/
#**************************************************************/
#
# The following two variables determine whether CORD based IPoE
# test environment is being used and if CORD based environment is used
# whether a single-node(single) test setup or two-node(two-node) 
# test setup is being used.
#
CORD_ENV="true"
#
# Change the CORD_TEST_SETUP variable to "two-node" for two-node CORD
# test setup environment.
CORD_TEST_SETUP="single"
IPOE_MGMT_SUBNET_PREFIX="172.30.100"
IPOE_SERVER_MGMT_IP="$IPOE_MGMT_SUBNET_PREFIX:1"
IPOE_MGMT_PORT=9020
#Note: Only IPOE_IPV6_SUB_PREFIX (48- bit) value can be 
#changed. The 64-bit IPOE_IPV6_PREFIX is derived from the
# IPOE_IPV6_SUB_PREFIX
IPOE_IPV6_SUB_PREFIX="FD64:8D64:AF0C"
IPOE_IPV6_PREFIX="$IPOE_IPV6_SUB_PREFIX:1"
dom_name="fj-ipoe.net"
domain_name_servers="$IPOE_IPV6_PREFIX::1"
ntp_servers="$IPOE_IPV6_PREFIX::1057"
sip_server_address="$IPOE_IPV6_PREFIX::1058"
# If a shared secret was to be configured in both the client and the server
# for DHCPv6 authentication, it would be specified in this file as follows:

# Secret should be encoded using base-64 generator. For example, feed the 
# chosen passwd (fj-ipoe-passwd) to any one of the online base-64 password
# generator and copy the generated base64 password text string into the
# secret key below.

secret_key="ZmotaXBvZS1wYXNzd2Q="

DHCP6S_IPOE_INTF=eth1
#
# The following is an example configuration which provides an IPv6 address
# from an address pool (fd64:8D64:AF0c:1::1500-2000) with a lease time of 3600
# seconds to any client attached to the eth1 interface. The IPOE_IPV6_ADDR_LOW
# IPOE_IPV6_ADDR_HIGH define the range of addresses to be allocated by
# DHCP6 server.
# 
IPOE_IPV6_ADDR_LOW=1500
IPOE_IPV6_ADDR_HIGH=2000
#
#Note: The DUID value specified for the host should match the duid value
# for the hosted stored in the file /var/lib/dhcpv6/dhcp6c_duid
#  DUID: for the host can be configured using REST API
#
#  DUID Type-3 format is used in the IPoE implementation.
#  DUID Type-3 format details: <octets-1, 2=00:03>, <oct-3-4=00:01>
#                      <octets=5-10=MAC address>
# 
# MAC address of the vcpe docker interface is constructed as
#       MAC_PREFIX:$stag_mod_hex:$ctag_mod_hex
#
#  $stag_mod_hex is hex value of stag and $ctag_mod_hex is the 
#  hex value of ctag.
#
DUID_PREFIX="00:03:00:01"
MAC_PREFIX="00:0E:10:00"
#
# VCPE docker name should have stag and ctag embedded in it.
# Note: The CTAG value should be non-overlapping (even if the stag value is 
# different between the vcpe instances). 
# Each vcpe name is followed by authentication control value (auth-enable or
# auth-disable) and PC client attached to the ONU (dibbler or windows). 
# The radvd configuration file generated will depend on the 
# type of PC client attached to the ONU.
#
VCPE_DOCKER_NAMES="vcpe-34-134:auth-enable:windows,vcpe-34-156:auth-enable:dibbler,vcpe-36-160:auth-enable:dibbler,vcpe-36-161:auth-disable:windows"

#############################################################
##### Parameters applicable to only wide-dhcp6c-client #####
############################################################
#DHC6C_WAN_INTF- interface used for connecting the vCPE docker to IPOE-Server
#DHC6C_LAN_INTF- interface used for connecting the vCPE docker to ONU

DHCP6C_WAN_INTF=eth2
DHCP6C_LAN_INTF=eth1
#
#
# Unprocessed wide dhcp6c raw script.
#
wide_dhcp6c_raw_script="wide-dhcp6c-script.raw"
#
# The name of the WIDE_DHCP6C_SCRIPT file that woudl be 
# executed by the wide-dhcp6-client when it receives 
# the IPV6 address assignment from the wide-dhcp6c-server
#
WIDE_DHCP6C_SCRIPT="wide-dhcp6c-script.sh"
#
# radvd-script. This script will be started
# by wide-dhcp6c-script to monitor the IPV6
# address to LAN interface and create the
# radvd.conf file and start the radvd daemon
# for SLAAC support.
#
RADVD_SCRIPT="radvd-script.sh"
#

#
# Information requested by DHCP6 client
# Following request parameters are supported:
# domain-name-servers, ntp-servers, sip-server-address
#
DHCP6C_REQUEST_PARAMS="domain-name-servers,ntp-servers"
#
#
##################################################################
#####      Parameters applicable to only NAT64 TAYGA         #####
##################################################################
#
TAYGA_IPV6_PREFIX="4000:0:0:2:eeee::/96"
TAYGA_ROUTER_IPV6_IP="4000:0:0:2::1"
TAYGA_ROUTER_IPV4_IP="172.16.254.1"
TAYGA_POOL="172.16.254.0/24"
NAMESERVER="8.8.8.8"

