#!/bin/bash
#*************************************************************/
#** File:         radvd-script.sh                            */
#**               (for Windows PC clients only)              */
#** Contents:     Contains shell script that would be        */
#**               invoked by the wide-dhcp6c-script. sh      */
#**               after it receives IPv6 address, prefix     */
#**               info, etc. from dhcp6 server               */
#**               This script will prepare config file for   */
#**               radvd and kick off radvd daemon            */
#************************************************************/
time_begin=`date`
if [ -z "$TIME_ZONE" ]; then
   TIME_ZONE=EDT
   echo "Using $TIME_ZONE as local time zone"
fi

function reinit_ipv6_routes() {
  cur_ipv6_prefix=`ifconfig eth2|grep Global|grep "/128"|awk '{print $3}' |awk -F':' '{print $1":"$2":"$3}'`
  prev_subnet_route=`ip -6 route show |grep eth2| grep "/64"|grep -v fe80|awk '{print $1}'`
  prev_default_route=`ip -6 route show |grep default| grep -v fe80|awk '{print $3}'`
  prev_ipv6_addr=`ifconfig eth2|grep Global|grep "/64"|awk '{print $3}'`
  echo "$cur_ipv6_prefix ...$prev_subnet_route $prev_default_route..."
  if [ ! -z "$prev_subnet_route" ]; then
    echo "Deleting previous subnet_route.... $prev_subnet_route"
    ip -6 route del $prev_subnet_route dev eth2
  fi
  if [ ! -z "$prev_default_route" ]; then
    echo "Deleting previous default_route.... $prev_default_route"
    ip -6 route del ::/0 via $prev_default_route dev eth2
  fi 
  ip -6 route del default 
  if [ ! -z "$cur_ipv6_prefix" ]; then
    echo "Setting up routes for the new prefix $cur_ipv6_prefix" 
    cur_subnet="$cur_ipv6_prefix:1::/64"
    echo "Adding the subnet route for $cur_subnet"
    ip -6 route add $cur_subnet dev eth2
    default_gw="$cur_ipv6_prefix:1::1"
    echo "Adding default gateway ... $default_gw"
    ip -6 route add ::/0 via $default_gw dev eth2
  else
    echo "ERROR..... no Global IPv6 address set in eth2.."
  fi
  if [ ! -z "$prev_ipv6_addr" ]; then
    echo "Deleting previous ipv6 addr.... $prev_ipv6_addr"
    ip addr del $prev_ipv6_addr dev eth2
  fi
}

#function trap_handler
#{
#     echo "Prevent the script from killing itself >>/tmp/dhcp6c.log "
#}
#
#trap trap_handler SIGINT SIGTERM SIGHUP 

#
#
# lan_id=`ifconfig eth1|grep Global|awk '{print $3'}|sed 's/^@@ipoe_ipv6_sub_prefix@@:*://g'`
#
if [ -f /tmp/dhcp6c.log ]; then
   touch /tmp/dhcp6c.log
fi
echo "***************************************************" >>/tmp/dhcp6c.log
echo "Begin wide-dhcp6c-script.sh $time_begin" >>/tmp/dhcp6c.log
echo "Waiting for global IPv6 address assignment for  @@dhcp6c_lan_intf@@" >>/tmp/dhcp6c.log
for ntime in {1..10}
do
   lan_intf_prefix=`ifconfig @@dhcp6c_lan_intf@@|grep Global|awk '{print $3}'|awk -F':' '{print $1":"$2":"$3":"$4":"}'`
   ipoe_subnet_prefix=`ifconfig @@dhcp6c_lan_intf@@|grep Global|awk '{print $3}'|awk -F':' '{print $1":"$2":"$3":"}'`
  if [ ! -z "$lan_intf_prefix" ]; then
    break
  fi 
  sleep 6 
  echo "Waiting for global IPv6 address for LAN _Intf count: $ntime" >>/tmp/dhcp6c.log
done
if [ -z "$lan_intf_prefix" ]; then
  echo "ERROR...Global address not assigned to @@dhcp6c_lan_intf@@" >>/tmp/dhcp6c.log
  echo "ERROR...radvd and dibbler-server not started. " >>/tmp/dhcp6c.log
  exit 1
fi  

wan_intf_addr=`ifconfig eth2|grep Global|grep "/128"|awk '{print $3}'|awk -F'/' '{print $1}'`
ipoe_subnet_prefix=`ifconfig eth2|grep Global| grep "/128" |awk '{print $3}'|awk -F':' '{print $1":"$2":"$3""}'`
wan_mac_addr=`ifconfig eth2|grep HWaddr|awk '{print $5}'`

reinit_ipv6_routes

echo "$wan_intf_addr ...$wan_mac_addr ..$ipoe_subnet_prefix...."
cat > /var/lib/dhcpv6/client.lease<< _EOF_ 
hwaddress $wan_mac_addr
iaaddress $wan_intf_addr
iaprefix $ipoe_subnet_prefix::/48
start-time $time_begin
end-time infinity
domain-name-servers $new_domain_name_servers
ntp-servers $new_ntp_servers
_EOF_

echo "Global IPv6 address asigned to @@dhcp6c_lan_intf@@ is $lan_intf_prefix" >>/tmp/dhcp6c.log

rm -f /etc/radvd.conf
touch /etc/radvd.conf
cat > /etc/radvd.conf << _EOF_
#*******************************************/ 
#  radvd.conf file                         */ 
#  Generated by wide-dhcp6-client script   */  
#  (to be used only for Windows PC clients)*/
#  Generation time: $time_begin            */           
#******************************************/   
interface @@dhcp6c_lan_intf@@ # LAN interface" 
{
  AdvManagedFlag off; # no DHCPv6 server on this interface.
  AdvOtherConfigFlag off; # 
  AdvSendAdvert on;
  AdvDefaultPreference high;
#
#
  MaxRtrAdvInterval 30;
#
# To block radvd from sending multicast router-advertisement
# periodically, uncomment the following line.
#  UnicastOnly on;
#
  AdvLinkMTU 1280;
#  prefix fd64:8d64:af0c:86::/64 #This is a sample setting
  prefix $lan_intf_prefix:1/64 
  {
     AdvOnLink on;
     AdvAutonomous on;
     AdvRouterAddr on;
  };
#
#Router preference
#
  route $ipoe_subnet_prefix::/48
  {
        AdvRoutePreference high;
        AdvRouteLifetime 120;
  };
  RDNSS $new_domain_name_servers
  {
         AdvRDNSSLifetime 120;
  };
};
_EOF_
#
#
#/etc/init.d/radvd stop
#radvd -d 5 -l /tmp/radvd.log -m logfile -C /etc/radvd.conf -p /var/run/radvd/radvd.pid 
/etc/init.d/radvd start
